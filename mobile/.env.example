# Copy to .env (gitignored) for local builds. In CI these come from GitHub variables and secrets.

# development | preview | production
APP_VARIANT=development

# Cloudflare Worker URL (https). Required for production builds.
EXPO_PUBLIC_API_BASE_URL=https://rozgarone-worker.jobi.workers.dev

# Set by CI from the release tag; optional locally
VERSION_NAME=
VERSION_CODE=

# iOS signing team (CI release builds)
APPLE_TEAM_ID=

# Optional: override app identifiers (default com.rozgarone.app)
ANDROID_PACKAGE=
IOS_BUNDLE_ID=

# AdMob (production only; non-production builds always use Google test IDs)
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
ADMOB_BANNER_ANDROID=
ADMOB_BANNER_IOS=
ADMOB_INTERSTITIAL_ANDROID=
ADMOB_INTERSTITIAL_IOS=
ADMOB_REWARDED_ANDROID=
ADMOB_REWARDED_IOS=
