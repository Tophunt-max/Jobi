# Copy to .env (gitignored) for local builds, or set these as EAS environment variables.

# development | preview | production
APP_VARIANT=development

# Cloudflare Worker URL (https). Required for production builds.
EXPO_PUBLIC_API_BASE_URL=https://rozgarone-worker.example.workers.dev

# Optional: EAS project and owner (set after `npx eas-cli@latest init`)
EAS_PROJECT_ID=
EXPO_OWNER=

# Optional: override app identifiers (defaults keep the Kotlin app's Play Store listing)
ANDROID_PACKAGE=
IOS_BUNDLE_ID=

# AdMob (production only; non-production builds always use Google test IDs)
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
ADMOB_BANNER_ANDROID=
ADMOB_BANNER_IOS=
ADMOB_INTERSTITIAL_ANDROID=
ADMOB_INTERSTITIAL_IOS=
ADMOB_REWARDED_ANDROID=
ADMOB_REWARDED_IOS=
