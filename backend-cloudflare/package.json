{
  "name": "rozgarone-worker",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply rozgarone_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rozgarone_db --remote",
    "db:seed:local": "wrangler d1 execute rozgarone_db --local --file=seed/dev_sample_jobs.sql",
    "test": "node --test test/",
    "deploy:ci": "wrangler d1 migrations apply rozgarone_db --remote && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
