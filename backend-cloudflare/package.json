{
  "name": "sarkari-jobs-worker",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply sarkari_jobs_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sarkari_jobs_db --remote",
    "db:seed:local": "wrangler d1 execute sarkari_jobs_db --local --file=seed/dev_sample_jobs.sql",
    "test": "node --test test/"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
