# Build-time configuration for the Android app. Copy to .env (gitignored) and fill in.
# None of these are secrets; anything compiled into an APK can be extracted.

# Your deployed Cloudflare Worker, e.g. https://sarkari-jobs-worker.<account>.workers.dev
API_BASE_URL=

# AdMob (release builds only; debug builds always use Google's test IDs).
# Leave blank to use Google's test IDs (no revenue).
ADMOB_APP_ID=
ADMOB_BANNER_ID=
ADMOB_INTERSTITIAL_ID=
ADMOB_REWARDED_ID=
ADMOB_NATIVE_ID=

# The Gemini API key is NOT configured here. Set it on the Worker:
#   npx wrangler secret put GEMINI_API_KEY
