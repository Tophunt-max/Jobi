<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Personal documents and the local cache are never backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="user_private_data.xml" />
        <exclude domain="database" path="sarkari_job_portal.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="user_private_data.xml" />
        <exclude domain="database" path="sarkari_job_portal.db" />
    </device-transfer>
</data-extraction-rules>
